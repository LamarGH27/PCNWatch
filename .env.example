# PCNWatch environment.
#
# Copy to `.env.local`. The scripts under `scripts/` read it automatically; real
# environment variables always win over it, so a file left in a checkout can
# never override a deployment's configuration.
#
# Nothing here is required for `npm run build`, `npm run lint` or `npm test` —
# the app builds without credentials so CI does not need them. An integration
# that is not configured refuses at its boundary; nothing falls back to demo data.

# ---------------------------------------------------------------------------
# Public (inlined into the client bundle — never put a secret here)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# MapLibre style. The default is MapLibre's demo tile server, which is fine for
# development and MUST be replaced before launch.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Feature flags. D-TRO stays off until credentials exist AND coverage has been
# measured for the boroughs we display.
NEXT_PUBLIC_FLAG_DTRO=off
NEXT_PUBLIC_FLAG_PAYMENTS=off

# ---------------------------------------------------------------------------
# Server-only
# ---------------------------------------------------------------------------

# Bypasses RLS. Only the ingestion pipeline, the Stripe webhook and the admin
# data-health page may use it.
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL with PostGIS and the migrations applied. Needed to write; a
# `npm run ingest:camden -- --dry-run` does not use it.
#   docker run -d --name pcnwatch-db -p 5432:5432 \
#     -e POSTGRES_PASSWORD=postgres postgis/postgis:16-3.4
#   PGHOST=localhost PGUSER=postgres PGPASSWORD=postgres npm run db:setup
DATABASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. Without a Price id the checkout builds an inline price from the
# catalogue, so a missing id cannot cause the wrong amount to be charged.
STRIPE_PRICE_DEFENCE=
STRIPE_PRICE_REJECTION_REVIEW=
STRIPE_PRICE_APPEAL_PACK=

# Camden open data. Optional: the JSON endpoint defaults to Camden's published
# PCN dataset (4k7m-4gkk), which has been probed live and is what the adapter is
# written against. Set this only to point at a different dataset or a replay.
CAMDEN_PCN_DATASET_URL=
# Optional Socrata app token; raises the rate limit.
CAMDEN_APP_TOKEN=

# D-TRO. Never exposed client-side.
DTRO_CLIENT_ID=
DTRO_CLIENT_SECRET=
DTRO_BASE_URL=

# Comma-separated emails allowed to reach /admin/data-health.
# Empty denies everyone, which is the correct default.
ADMIN_EMAIL_ALLOWLIST=

# Shared secret for triggering ingestion from a scheduler.
INGEST_TRIGGER_SECRET=
