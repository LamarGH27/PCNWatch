# Copy to .env.local. Scripts read it automatically; real environment
# variables always win, so this never overrides a deployment's configuration.

# PostgreSQL with PostGIS, migrations applied via `npm run db:setup`.
# Only needed to write — a dry run does not use it.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/pcnwatch"

# Optional. Camden's dataset endpoint defaults to the verified one
# (4k7m-4gkk); set this only to point at a different dataset or a replay.
# CAMDEN_PCN_DATASET_URL="https://opendata.camden.gov.uk/resource/4k7m-4gkk.json"

# Optional. A Socrata app token raises the anonymous rate limit.
# CAMDEN_APP_TOKEN=""
