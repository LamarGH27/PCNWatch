# PCNWatch environment.
#
# Copy to `.env.local`. The scripts under `scripts/` read it automatically; real
# environment variables always win over it, so a file left in a checkout can
# never override a deployment's configuration.
#
# Nothing here is required for `npm run build`, `npm run lint` or `npm test` —
# the app builds without credentials so CI does not need them. An integration
# that is not configured refuses at its boundary; nothing falls back to demo data.

# ---------------------------------------------------------------------------
# Public (inlined into the client bundle — never put a secret here)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# MapLibre basemap style.
#
# The default below is MapLibre's demo style: country outlines only, stopping at
# about zoom 5. At the zoom this product uses it draws NOTHING — the enforcement
# data appears on a flat colour with no streets under it. The map says so when it
# is in use, but it is not usable for development, let alone launch.
#
# Set this to a street-level style. The choice is a licensing decision, not a
# technical one, so it is left to you:
#
#   OpenFreeMap    https://tiles.openfreemap.org/styles/liberty
#                  OSM data, no key, no usage limits stated, self-hostable.
#   Protomaps      Self-hosted from a single downloadable file; no third party
#                  sees your users' viewports.
#   MapTiler       https://api.maptiler.com/maps/streets-v2/style.json?key=KEY
#                  Requires an account; a free tier exists.
#   Ordnance Survey OS Maps API — British authority data, requires a key.
#
# Whichever you pick, set NEXT_PUBLIC_MAP_ATTRIBUTION to match its terms: every
# one of these requires attribution, and the tiles are fetched by the visitor's
# browser, so their viewport is visible to whoever serves them.
#
# Chosen for staging: OpenFreeMap Liberty. The attribution below is what its
# terms and OpenMapTiles' require.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenFreeMap © OpenMapTiles © OpenStreetMap contributors

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Feature flags. D-TRO stays off until credentials exist AND coverage has been
# measured for the boroughs we display.
NEXT_PUBLIC_FLAG_DTRO=off
NEXT_PUBLIC_FLAG_PAYMENTS=off

# ---------------------------------------------------------------------------
# Server-only
# ---------------------------------------------------------------------------

# Bypasses RLS. Only the ingestion pipeline, the Stripe webhook and the admin
# data-health page may use it.
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL with PostGIS and the migrations applied. Needed to write; a
# `npm run ingest:camden -- --dry-run` does not use it.
#   docker run -d --name pcnwatch-db -p 5432:5432 \
#     -e POSTGRES_PASSWORD=postgres postgis/postgis:16-3.4
#   PGHOST=localhost PGUSER=postgres PGPASSWORD=postgres npm run db:setup
DATABASE_URL=
# On a serverless host (Vercel) this MUST be the Supabase *transaction* pooler,
# not the session pooler and not the direct host:
#   - direct host is IPv6-only and unreachable from Vercel;
#   - the session pooler holds one server connection per client, which a
#     platform that scales to many short-lived instances exhausts.
# Ingestion is the opposite case and keeps using the session pooler: it runs a
# long batch from one machine, outside Vercel.

# Not set for the public staging deployment. Without it /analyse says automatic
# reading is unavailable and disables the controls, which is the honest state —
# it does not present a funnel that cannot complete.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. Without a Price id the checkout builds an inline price from the
# catalogue, so a missing id cannot cause the wrong amount to be charged.
STRIPE_PRICE_DEFENCE=
STRIPE_PRICE_REJECTION_REVIEW=
STRIPE_PRICE_APPEAL_PACK=

# Camden open data. Optional: the JSON endpoint defaults to Camden's published
# PCN dataset (4k7m-4gkk), which has been probed live and is what the adapter is
# written against. Set this only to point at a different dataset or a replay.
CAMDEN_PCN_DATASET_URL=
# Optional Socrata app token; raises the rate limit.
CAMDEN_APP_TOKEN=

# D-TRO. Never exposed client-side.
DTRO_CLIENT_ID=
DTRO_CLIENT_SECRET=
DTRO_BASE_URL=

# Comma-separated emails allowed to reach /admin/data-health.
# Empty denies everyone, which is the correct default.
ADMIN_EMAIL_ALLOWLIST=

# Shared secret for triggering ingestion from a scheduler.
INGEST_TRIGGER_SECRET=
